{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "id": null,
  "uid": "hakux-lr-telemetry-draft",
  "title": "hakuX-lr performance",
  "description": "Draft dashboard for comparing Xbox game performance across hakuX-lr CPU backends and correction paths.",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "hakuX-lr",
    "emulation"
  ],
  "editable": true,
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(hakux_retro_runs_total, instance)",
        "definition": "label_values(hakux_retro_runs_total, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "game",
        "label": "Game",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(hakux_retro_runs_total, game)",
        "definition": "label_values(hakux_retro_runs_total, game)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "backend",
        "label": "Backend",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(hakux_retro_runs_total, backend)",
        "definition": "label_values(hakux_retro_runs_total, backend)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "variant",
        "label": "Variant",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": "label_values(hakux_retro_runs_total, variant)",
        "definition": "label_values(hakux_retro_runs_total, variant)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Framerate",
      "description": "New frames delivered to RetroArch and frontend ticks per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 10,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "fps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "rate(hakux_presented_frames_total{instance=~\"${instance:regex}\",game=~\"${game:regex}\",backend=~\"${backend:regex}\",variant=~\"${variant:regex}\"}[$__rate_interval])",
          "legendFormat": "New frames \u00b7 {{game}} \u00b7 {{variant}} \u00b7 {{backend}} \u00b7 {{instance}}",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "rate(hakux_retro_runs_total{instance=~\"${instance:regex}\",game=~\"${game:regex}\",backend=~\"${backend:regex}\",variant=~\"${variant:regex}\"}[$__rate_interval])",
          "legendFormat": "Frontend ticks \u00b7 {{game}} \u00b7 {{variant}} \u00b7 {{backend}} \u00b7 {{instance}}",
          "range": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Frametime",
      "description": "Intervals between fresh frames submitted to RetroArch.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 10,
        "y": 0,
        "w": 14,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "1000 * histogram_quantile(0.5, sum by (le, instance, game, backend, variant) (rate(hakux_frame_interval_seconds_bucket{instance=~\"${instance:regex}\",game=~\"${game:regex}\",backend=~\"${backend:regex}\",variant=~\"${variant:regex}\"}[$__rate_interval])))",
          "legendFormat": "p50 \u00b7 {{game}} \u00b7 {{variant}} \u00b7 {{backend}} \u00b7 {{instance}}",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "1000 * histogram_quantile(0.95, sum by (le, instance, game, backend, variant) (rate(hakux_frame_interval_seconds_bucket{instance=~\"${instance:regex}\",game=~\"${game:regex}\",backend=~\"${backend:regex}\",variant=~\"${variant:regex}\"}[$__rate_interval])))",
          "legendFormat": "p95 \u00b7 {{game}} \u00b7 {{variant}} \u00b7 {{backend}} \u00b7 {{instance}}",
          "range": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "1000 * histogram_quantile(0.99, sum by (le, instance, game, backend, variant) (rate(hakux_frame_interval_seconds_bucket{instance=~\"${instance:regex}\",game=~\"${game:regex}\",backend=~\"${backend:regex}\",variant=~\"${variant:regex}\"}[$__rate_interval])))",
          "legendFormat": "p99 \u00b7 {{game}} \u00b7 {{variant}} \u00b7 {{backend}} \u00b7 {{instance}}",
          "range": true,
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "1000 * hakux_frame_interval_recent_max_seconds{instance=~\"${instance:regex}\",game=~\"${game:regex}\",backend=~\"${backend:regex}\",variant=~\"${variant:regex}\"}",
          "legendFormat": "Recent max \u00b7 {{game}} \u00b7 {{variant}} \u00b7 {{backend}} \u00b7 {{instance}}",
          "range": true,
          "refId": "D",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Xbox kernel and system ops",
      "description": "Kernel exports and guest system-op callbacks per second. These counts can overlap.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "rate(hakux_kernel_calls_total{instance=~\"${instance:regex}\",game=~\"${game:regex}\",backend=~\"${backend:regex}\",variant=~\"${variant:regex}\"}[$__rate_interval])",
          "legendFormat": "Kernel calls \u00b7 {{game}} \u00b7 {{variant}} \u00b7 {{backend}} \u00b7 {{instance}}",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        },
        {
          "expr": "rate(hakux_guest_system_ops_total{instance=~\"${instance:regex}\",game=~\"${game:regex}\",backend=~\"${backend:regex}\",variant=~\"${variant:regex}\"}[$__rate_interval])",
          "legendFormat": "System ops \u00b7 {{game}} \u00b7 {{variant}} \u00b7 {{backend}} \u00b7 {{instance}}",
          "range": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "KVM userspace returns by reason",
      "description": "Returns per second from the main KVM_RUN loop. Includes a separate interrupted series.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "rate(hakux_kvm_userspace_returns_total{instance=~\"${instance:regex}\",game=~\"${game:regex}\",backend=~\"${backend:regex}\",variant=~\"${variant:regex}\"}[$__rate_interval])",
          "legendFormat": "{{reason}} \u00b7 {{game}} \u00b7 {{variant}} \u00b7 {{backend}} \u00b7 {{instance}}",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU corrections per new frame",
      "description": "RCP and RSQRT corrections per submitted frame over the same rolling window.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 16,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (instance, game, backend, variant, instruction, operand, path) (increase(hakux_cpu_corrections_total{instance=~\"${instance:regex}\",game=~\"${game:regex}\",backend=~\"${backend:regex}\",variant=~\"${variant:regex}\"}[$__rate_interval])) / on (instance, game, backend, variant) group_left () (increase(hakux_presented_frames_total{instance=~\"${instance:regex}\",game=~\"${game:regex}\",backend=~\"${backend:regex}\",variant=~\"${variant:regex}\"}[$__rate_interval]) > 0)",
          "legendFormat": "{{instruction}} {{operand}} {{path}} \u00b7 {{game}} \u00b7 {{variant}} \u00b7 {{backend}} \u00b7 {{instance}}",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Dropped telemetry snapshots",
      "description": "Sender drops in the query window. Cumulative counts recover on the next successful snapshot.",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 16,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "increase(hakux_telemetry_dropped_snapshots_total{instance=~\"${instance:regex}\",game=~\"${game:regex}\",backend=~\"${backend:regex}\",variant=~\"${variant:regex}\"}[$__rate_interval])",
          "legendFormat": "{{game}} \u00b7 {{variant}} \u00b7 {{backend}} \u00b7 {{instance}}",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ]
    }
  ]
}
