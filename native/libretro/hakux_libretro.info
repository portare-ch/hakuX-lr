# hakuX's core info for RetroArch (LIBRETRO_SPEC.md section 10).
# savestate = "false": with no save states RetroArch never runs ahead,
# which would load a second hakuX into its process.
display_name = "Microsoft - Xbox (hakuX)"
authors = "hakuX contributors"
supported_extensions = "iso|chd"
corename = "hakuX"
categories = "Emulator"
license = "GPLv3+"
permissions = ""
display_version = "dev"
manufacturer = "Microsoft"
systemname = "Xbox"
systemid = "xbox"
database = "Microsoft - Xbox"
supports_no_game = "true"
needs_fullpath = "true"
savestate = "false"
savestate_features = "null"
cheats = "false"
input_descriptors = "true"
memory_descriptors = "false"
libretro_saves = "false"
core_options = "true"
core_options_version = "2.0"
load_subsystem = "false"
hw_render = "true"
required_hw_api = "Vulkan >= 1.3"
is_experimental = "true"
description = "Original Xbox emulator for ARM64 and x86-64 Linux. Uses Vulkan graphics and requires no BIOS, MCPX ROM or hard disk image."
notes = "(!) Requires ARM64 or x86-64 Linux, Vulkan 1.3 and RetroArch's vulkan video driver.|x86-64 requires Linux 5.16+, access to /dev/kvm, TSC scaling and UMIP.|Game saves and caches are stored in hdd/ and cache/ under RetroArch's save directory.|Start Core (no content) boots the Xbox dashboard installed in hdd/Partition2.|Save states, rewind and run-ahead are not supported."
