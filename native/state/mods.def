/* Each saved XBE patch stores the image name, guest address, length,
 * original bytes and patched bytes so it can be reverted on load.
 * MODS v2 adds a flag for games changed by cheats, patches or mods. */
NC_SECTION(MODS)

NC_REC(NcModsState, 8)
NC_F(NcModsState, npatches, U32, 1, 1, 0)
NC_F(NcModsState, modified, U32, 1, 2, 0)
NC_END(NcModsState)

NC_REC(NcModsPatch, 136)
NC_F(NcModsPatch, xbe, U8, 128, 1, 0)
NC_F(NcModsPatch, va, U32, 1, 1, 0)
NC_F(NcModsPatch, n, U32, 1, 1, 0)
NC_END(NcModsPatch)
